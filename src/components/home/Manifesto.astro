---
// Frase gigante horizontal com pin (referência: "We wanna be where the people are", da truus).
// As letras "caem como bolas de gelato" ao entrar; stickers e setas se desenham entre as palavras.
import Doodle from '../marca/Doodle.astro';

type Parte = { tipo: 'palavra'; texto: string; obliqua?: boolean } | { tipo: 'sticker'; doodle: 'xicara' | 'ramo' | 'sol'; cor: string } | { tipo: 'seta' };

const partes: Parte[] = [
  { tipo: 'palavra', texto: 'Tradição' },
  { tipo: 'sticker', doodle: 'xicara', cor: 'var(--c-ambar)' },
  { tipo: 'seta' },
  { tipo: 'palavra', texto: 'Inovação' },
  { tipo: 'sticker', doodle: 'ramo', cor: 'var(--c-pistache-creme)' },
  { tipo: 'seta' },
  { tipo: 'palavra', texto: 'e sabor', obliqua: true },
  { tipo: 'sticker', doodle: 'sol', cor: 'var(--c-rosa)' },
];
const blob =
  'M50 4c12-1 22 6 27 15 11 2 19 12 18 23 6 8 5 20-3 26 1 12-9 22-21 22-6 6-17 8-25 3-11 4-23-1-27-12C8 77 2 66 6 55 0 46 3 33 13 28c1-13 14-22 27-19 3-3 6-5 10-5Z';
---

<section id="manifesto" class="manifesto" data-mundo="fior" aria-label="Tradição, inovação e sabor">
  <div class="manifesto__palco">
    <div class="manifesto__trilho">
      <p class="manifesto__frase t-gigante" aria-label="Tradição, inovação e sabor.">
        {
          partes.map((p) => {
            if (p.tipo === 'palavra')
              return (
                <span class:list={['manifesto__palavra', { obliqua: p.obliqua }]} aria-hidden="true">
                  {[...p.texto.toUpperCase()].map((ch) =>
                    ch === ' ' ? <span class="manifesto__espaco"> </span> : <span class="manifesto__letra">{ch}</span>,
                  )}
                </span>
              );
            if (p.tipo === 'sticker')
              return (
                <span class="manifesto__sticker" style={`--cor:${p.cor}`} aria-hidden="true">
                  <svg class="manifesto__sticker-forma" viewBox="0 0 100 100">
                    <path d={blob} />
                  </svg>
                  <span class="manifesto__sticker-arte">
                    <Doodle nome={p.doodle} tracoPx={2.6} />
                  </span>
                </span>
              );
            return (
              <span class="manifesto__seta" aria-hidden="true">
                <svg viewBox="0 0 300 110" fill="none">
                  <path
                    d="M6 92C40 30 102 6 160 22c40 11 70 40 98 62"
                    stroke="currentColor"
                    stroke-width="5"
                    stroke-linecap="round"
                  />
                  <path d="M228 86l32 2-6-31" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            );
          })
        }
      </p>
    </div>
    <p class="manifesto__apoio t-lead">
      A Crema Lab nasceu em 2024, no Batel, do encontro entre a técnica italiana e a curiosidade de quem vive testando.
      Aqui tudo começa do zero — <span class="manifesto__destaque" data-rabisco="marca-texto" data-rabisco-cor="#f1a500">até a pasta de pistache.</span>
    </p>
  </div>
</section>

<style>
  .manifesto {
    position: relative;
    overflow: hidden;
  }
  .manifesto__palco {
    position: relative;
    height: 100svh;
    display: grid;
    align-content: center;
  }
  .manifesto__trilho {
    display: flex;
    width: max-content;
    will-change: transform;
  }
  .manifesto__frase {
    display: flex;
    align-items: center;
    gap: 0.16em;
    white-space: nowrap;
    color: var(--c-terracota);
    font-size: clamp(6rem, 17vw, 19rem);
    line-height: 1;
    padding-inline: 4vw;
  }
  .manifesto__palavra {
    display: inline-flex;
  }
  .manifesto__letra {
    display: inline-block;
    will-change: transform;
  }
  .manifesto__espaco {
    display: inline-block;
    width: 0.32em;
  }
  .manifesto__sticker {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 0.62em;
    aspect-ratio: 1;
    flex: none;
    rotate: -8deg;
  }
  .manifesto__sticker:nth-of-type(even) {
    rotate: 9deg;
  }
  .manifesto__sticker-forma {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: var(--cor);
    stroke: var(--c-fior);
    stroke-width: 3;
    paint-order: stroke;
    filter: drop-shadow(0 5px 0 rgb(43 33 28 / 0.18));
  }
  .manifesto__sticker-arte {
    position: relative;
    width: 56%;
    color: var(--c-cacau);
  }
  .manifesto__seta {
    display: inline-block;
    width: 0.9em;
    flex: none;
    color: var(--c-cacau);
    translate: 0 -0.12em;
  }
  .manifesto__seta svg {
    width: 100%;
    height: auto;
  }
  .manifesto__apoio {
    position: absolute;
    left: calc(var(--margem) + 8px);
    bottom: clamp(32px, 7vh, 72px);
    max-width: 40ch;
    font-size: clamp(1.05rem, 1.35vw, 1.3rem);
  }
  .manifesto__destaque {
    padding: 0 2px;
  }

  :global(.sem-movimento) .manifesto__palco {
    height: auto;
    padding-block: var(--respiro);
  }
  :global(.sem-movimento) .manifesto__frase {
    flex-direction: column;
    align-items: flex-start;
    white-space: normal;
    font-size: clamp(3rem, 11vw, 10rem);
  }
  :global(.sem-movimento) .manifesto__seta {
    display: none;
  }
  :global(.sem-movimento) .manifesto__apoio {
    position: static;
    margin: 32px var(--margem) 0;
  }

  @media (max-width: 767px) {
    .manifesto__frase {
      font-size: clamp(5rem, 30vw, 9rem);
    }
    .manifesto__apoio {
      right: var(--margem);
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger, reduzido } from '../../scripts/nucleo';

  const secao = document.querySelector<HTMLElement>('.manifesto');
  if (secao && !reduzido) {
    const palco = secao.querySelector<HTMLElement>('.manifesto__palco')!;
    const trilho = secao.querySelector<HTMLElement>('.manifesto__trilho')!;
    const letras = secao.querySelectorAll<HTMLElement>('.manifesto__letra');
    const stickers = secao.querySelectorAll<HTMLElement>('.manifesto__sticker');
    const setas = secao.querySelectorAll<SVGPathElement>('.manifesto__seta path');

    const distancia = () => Math.max(2000, (trilho.scrollWidth - window.innerWidth * 0.5) * 0.5);

    const movimento = gsap.timeline({
      scrollTrigger: {
        trigger: secao,
        start: 'top bottom',
        end: () => `+=${window.innerHeight + distancia()}`,
        scrub: 1,
        invalidateOnRefresh: true,
      },
    });
    movimento
      .fromTo(
        trilho,
        { x: () => window.innerWidth },
        { x: () => window.innerWidth * 0.45, ease: 'none', duration: window.innerHeight },
      )
      .to(trilho, {
        x: () => -(trilho.scrollWidth - window.innerWidth * 0.55),
        ease: 'none',
        duration: distancia(),
      });

    ScrollTrigger.create({
      trigger: secao,
      start: 'top top',
      end: () => `+=${distancia()}`,
      pin: palco,
      pinSpacing: true,
      invalidateOnRefresh: true,
    });

    letras.forEach((letra) => {
      gsap.from(letra, {
        yPercent: gsap.utils.random(-230, 230),
        rotation: gsap.utils.random(-32, 32),
        ease: 'elastic.out(1.2, 1)',
        scrollTrigger: {
          trigger: letra,
          containerAnimation: movimento,
          start: 'left 92%',
          end: 'left 52%',
          scrub: 0.5,
        },
      });
    });
    stickers.forEach((s) => {
      gsap.from(s, {
        scale: 0,
        rotation: gsap.utils.random(-50, 50),
        yPercent: gsap.utils.random(-120, 120),
        ease: 'elastic.out(1.2, 1)',
        scrollTrigger: { trigger: s, containerAnimation: movimento, start: 'left 92%', end: 'left 55%', scrub: 0.5 },
      });
    });
    setas.forEach((p) => {
      gsap.fromTo(
        p,
        { drawSVG: '0% 0%' },
        {
          drawSVG: '0% 100%',
          ease: 'none',
          scrollTrigger: { trigger: p.closest('.manifesto__seta'), containerAnimation: movimento, start: 'left 85%', end: 'left 45%', scrub: 0.5 },
        },
      );
    });
  }
</script>
