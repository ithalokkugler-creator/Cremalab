---
// Mapa ilustrativo de Curitiba desenhado com Rough.js no build (sem custo no navegador).
// Não é um mapa de navegação: as posições são aproximadas, só para orientar.
import rough from 'roughjs';
import { unidadesAtivas } from '../../data/unidades';
import { CORES } from '../../data/site';
import { arredondarPath } from '../../scripts/util';

interface Props {
  id: string;
  class?: string;
}
const { id, class: classe } = Astro.props;

type Info = { d: string; stroke: string; strokeWidth: number; fill?: string };
const gen = rough.generator();
const caminhos = (drawable: ReturnType<typeof gen.curve>): Info[] =>
  gen.toPaths(drawable).map((p) => ({ d: arredondarPath(p.d), stroke: p.stroke, strokeWidth: p.strokeWidth, fill: p.fill }));

const CACAU = '#2b211c';
const quadras: Info[] = [];
let semente = 11;
for (let x = 470; x <= 900; x += 62) {
  for (let y = 300; y <= 620; y += 56) {
    if ((x * 7 + y * 3) % 5 === 0) continue;
    quadras.push(
      ...caminhos(
        gen.rectangle(x, y, 44 + ((x + y) % 9), 36 + ((x * y) % 7), {
          roughness: 1.1,
          stroke: CACAU,
          strokeWidth: 1,
          seed: semente++,
        }),
      ),
    );
  }
}
const parque = caminhos(
  gen.polygon(
    [
      [120, 180],
      [210, 130],
      [330, 160],
      [370, 250],
      [340, 340],
      [250, 360],
      [160, 330],
      [110, 260],
    ],
    { roughness: 1.4, stroke: CACAU, strokeWidth: 1.6, fill: '#a3a86b', fillStyle: 'hachure', hachureGap: 10, fillWeight: 1.3, seed: 3 },
  ),
);
const lago = caminhos(
  gen.ellipse(245, 250, 120, 70, { roughness: 1.2, stroke: CACAU, strokeWidth: 1.4, fill: CORES.fior, fillStyle: 'solid', seed: 5 }),
);
const ruas = [
  [
    [40, 520],
    [300, 470],
    [560, 452],
    [820, 420],
    [980, 380],
  ],
  [
    [700, 40],
    [704, 238],
    [688, 430],
    [660, 690],
  ],
  [
    [150, 60],
    [214, 392],
    [262, 680],
  ],
  [
    [400, 90],
    [620, 180],
    [880, 300],
  ],
  [
    [40, 640],
    [380, 600],
    [520, 660],
  ],
].flatMap((pts, i) =>
  caminhos(gen.curve(pts as [number, number][], { roughness: 1.1, bowing: 0.9, stroke: CACAU, strokeWidth: 2.4, seed: 30 + i })),
);

const unidades = unidadesAtivas();
const circulos = unidades.map((u, i) =>
  caminhos(gen.circle(u.mapa.x, u.mapa.y, 92, { roughness: 1.6, bowing: 1.4, stroke: CORES.terracota, strokeWidth: 2.6, seed: 70 + i })),
);
const bairros = [
  { nome: 'Parque Barigui', x: 238, y: 405 },
  { nome: 'Mossunguê', x: 150, y: 460 },
  { nome: 'Batel', x: 598, y: 520 },
  { nome: 'Centro Cívico', x: 808, y: 206 },
];
---

<svg class:list={['mapa', classe]} viewBox="0 0 1000 700" role="img" aria-labelledby={`${id}-t`} focusable="false" data-mapa>
  <title id={`${id}-t`}>Mapa ilustrativo das unidades da Crema Lab em Curitiba</title>
  <g class="mapa__quadras" fill="none" opacity="0.28">
    {quadras.map((p) => <path d={p.d} stroke={p.stroke} stroke-width={p.strokeWidth} />)}
  </g>
  <g class="mapa__parque" fill="none">
    {parque.map((p) => <path d={p.d} stroke={p.stroke} stroke-width={p.strokeWidth} />)}
    {lago.map((p) => <path d={p.d} stroke={p.stroke} stroke-width={p.strokeWidth} fill={p.fill === 'none' ? 'none' : p.fill} />)}
    <path class="mapa__onda" d="M205 248c10-8 20 8 30 0s20 8 30 0" stroke={CACAU} stroke-width="1.4" stroke-linecap="round"></path>
    <path class="mapa__onda" d="M215 266c10-8 20 8 30 0s20 8 30 0" stroke={CACAU} stroke-width="1.4" stroke-linecap="round"></path>
  </g>
  <g class="mapa__ruas" fill="none" stroke-linecap="round">
    {ruas.map((p) => <path d={p.d} stroke={p.stroke} stroke-width={p.strokeWidth} />)}
  </g>
  <g class="mapa__bairros">
    {
      bairros.map((b) => (
        <text x={b.x} y={b.y} text-anchor="middle" class="mapa__bairro">
          {b.nome.toUpperCase()}
        </text>
      ))
    }
  </g>
  {
    unidades.map((u, i) => (
      <g class="mapa__unidade" data-unidade={u.slug}>
        <g class="mapa__circulo" fill="none">
          {circulos[i].map((p) => (
            <path d={p.d} stroke={p.stroke} stroke-width={p.strokeWidth} stroke-linecap="round" />
          ))}
        </g>
        <g transform={`translate(${u.mapa.x} ${u.mapa.y})`}>
          <g class="mapa__pino">
          <path
            d="M0 0C-4 -10 -26 -24 -26 -44a26 26 0 0 1 52 0C26 -24 4 -10 0 0Z"
            fill={CORES[u.mundo]}
            stroke={CACAU}
            stroke-width="2.4"
            stroke-linejoin="round"
          />
          <use href="#simbolo-monograma" x="-8" y="-60" width="16" height="30" fill={u.mundo === 'terracota' ? CORES.fior : CACAU} />
          </g>
        </g>
        <text
          x={u.mapa.x > 640 ? u.mapa.x - 34 : u.mapa.x + 34}
          y={u.mapa.y - 34}
          text-anchor={u.mapa.x > 640 ? 'end' : 'start'}
          class="mapa__rotulo">
          {u.nomeCurto.toUpperCase()}
        </text>
      </g>
    ))
  }
</svg>

<style>
  .mapa {
    width: 100%;
    height: auto;
    color: var(--c-cacau);
  }
  .mapa__bairro {
    font-family: var(--f-texto);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 3px;
    fill: color-mix(in srgb, var(--c-cacau) 55%, transparent);
  }
  .mapa__rotulo {
    font-family: var(--f-display);
    font-size: 19px;
    letter-spacing: 2px;
    fill: var(--c-cacau);
    paint-order: stroke;
    stroke: var(--bg, #f5efe6);
    stroke-width: 6px;
  }
</style>
