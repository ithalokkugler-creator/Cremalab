---
// "Quem faz": a foto da equipe como uma impressão presa com fita — dá para arrastar e ela volta.
import { Image } from 'astro:assets';
import equipe from '../../assets/fotos/equipe.jpg';
---

<section class="equipe secao" id="equipe" data-mundo="fior" aria-labelledby="equipe-titulo">
  <div class="casca equipe__grade">
    <div class="equipe__texto">
      <p class="t-eyebrow equipe__eyebrow" data-anim="subir">A crew</p>
      <h2 id="equipe-titulo" class="t-h2" data-anim="titulo">Quem faz a felicidade atemporal.</h2>
      <p class="t-lead" data-anim="subir">
        Do laboratório ao balcão: quem escolhe a fruta, quem bate a base, quem monta a vitrine com a espátula e quem te
        serve um affogato sem pressa.
      </p>
      <p class="t-corpo equipe__corpo" data-anim="subir">
        A Crema Lab nasceu do método da chef Harlen Brandão e cresceu com uma equipe inteira treinada nele. São eles que
        fazem cada casa ter o mesmo sabor — e o mesmo sorriso.
      </p>
    </div>

    <figure class="equipe__foto" data-cursor="arraste">
      <span class="equipe__fita equipe__fita--a" aria-hidden="true"></span>
      <span class="equipe__fita equipe__fita--b" aria-hidden="true"></span>
      <Image
        src={equipe}
        alt="A equipe da Crema Lab reunida e sorrindo em frente ao mural da loja, sobre o piso de cacos cerâmicos"
        widths={[400, 497]}
        sizes="(max-width: 899px) 80vw, 420px"
        draggable="false"
      />
      <figcaption class="t-anotacao equipe__legenda">a crew da Crema Lab ♥</figcaption>
    </figure>
  </div>
</section>

<style>
  .equipe__grade {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
    gap: clamp(36px, 6vw, 96px);
    align-items: center;
  }
  .equipe__texto {
    display: grid;
    gap: 20px;
  }
  .equipe__eyebrow {
    color: var(--c-telha);
  }
  .equipe__corpo {
    max-width: 52ch;
    color: var(--suave);
  }
  .equipe__foto {
    position: relative;
    justify-self: center;
    width: min(100%, 420px);
    padding: 14px 14px 0;
    background: #fffaf2;
    box-shadow:
      0 30px 60px -30px rgb(43 33 28 / 0.55),
      0 2px 0 rgb(43 33 28 / 0.06);
    cursor: grab;
    touch-action: pan-y;
  }
  .equipe__foto:active {
    cursor: grabbing;
  }
  .equipe__foto :global(img) {
    width: 100%;
    aspect-ratio: 497 / 560;
    object-fit: cover;
    object-position: 50% 30%;
    pointer-events: none;
  }
  .equipe__legenda {
    padding: 12px 6px 16px;
    text-align: center;
    font-size: 1.45rem;
    color: var(--c-telha);
  }
  .equipe__fita {
    position: absolute;
    z-index: 2;
    width: 110px;
    height: 30px;
    background: rgb(218 211 167 / 0.78);
    box-shadow: 0 2px 6px rgb(43 33 28 / 0.12);
  }
  .equipe__fita--a {
    top: -12px;
    left: -26px;
    rotate: -32deg;
  }
  .equipe__fita--b {
    top: -10px;
    right: -26px;
    rotate: 28deg;
  }
  @media (max-width: 899px) {
    .equipe__grade {
      grid-template-columns: minmax(0, 1fr);
    }
    .equipe__foto {
      width: min(86%, 400px);
    }
    .equipe__fita {
      width: 84px;
    }
    .equipe__fita--a {
      left: -14px;
    }
    .equipe__fita--b {
      right: -14px;
    }
  }
</style>

<script>
  import { gsap, reduzido } from '../../scripts/nucleo';
  import { Draggable } from 'gsap/Draggable';
  gsap.registerPlugin(Draggable);

  const foto = document.querySelector<HTMLElement>('.equipe__foto');
  if (foto) {
    foto.style.rotate = 'none';
    gsap.set(foto, { rotation: 3 });
    if (!reduzido) {
      gsap.from(foto, {
        yPercent: 30,
        rotation: 14,
        opacity: 0,
        duration: 1.3,
        ease: 'creme',
        scrollTrigger: { trigger: foto, start: 'top 85%', once: true },
      });
      // puxa a foto e ela volta para o lugar, balançando
      Draggable.create(foto, {
        type: 'x,y',
        onDrag() {
          gsap.to(foto, { rotation: 3 + this.deltaX * 0.6, duration: 0.3, overwrite: 'auto' });
        },
        onRelease() {
          gsap.to(foto, { x: 0, y: 0, duration: 1.1, ease: 'elastic.out(1, 0.45)' });
          gsap.to(foto, { rotation: 3, duration: 1.4, ease: 'elastic.out(1, 0.35)' });
        },
      });
    }
  }
</script>
