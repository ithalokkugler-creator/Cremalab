---
// Ficha de laboratório de um sabor: cartão com canto dobrado, ilustração e anotações.
import Bola from './Bola.astro';
import { type Sabor, ROTULO_TAG } from '../../data/sabores';

interface Props {
  sabor: Sabor;
}
const { sabor: s } = Astro.props;
const filtros = [s.categoria, s.temporada ? 'sazonal' : 'casa', ...(s.tags ?? [])].join(' ');
---

<article class="ficha" id={s.id} data-filtros={filtros} style={`--cor-sabor:${s.cor}`}>
  <svg class="ficha__canto" viewBox="0 0 60 60" aria-hidden="true">
    <path class="ficha__dobra" d="M0 0H60V60C46 44 22 30 0 0Z"></path>
    <path d="M0 0C22 30 46 44 60 60" fill="none" stroke="var(--c-cacau)" stroke-width="1.4" stroke-linecap="round"></path>
  </svg>
  <div class="ficha__bola">
    <Bola sabor={s} id={`ficha-${s.id}`} />
  </div>
  <div class="ficha__textos">
    <p class="ficha__meta t-rotulo">
      {s.categoria}
      {s.temporada && <> · {s.temporada}</>}
      {!s.temporada && s.classico && <> · clássico</>}
    </p>
    <h3 class="ficha__nome t-h3">{s.nome}</h3>
    <p class="ficha__desc">{s.descricao}</p>
    {
      (s.tags?.length || s.unidade) && (
        <ul class="ficha__tags" role="list">
          {s.unidade && (
            <li class="pilula ficha__unidade">
              {s.unidade.tipo === 'exclusivo' ? 'só no' : 'versão do'} {s.unidade.nome}
            </li>
          )}
          {s.tags?.map((t) => (
            <li class="pilula">{ROTULO_TAG[t]}</li>
          ))}
        </ul>
      )
    }
  </div>
</article>

<style>
  .ficha {
    position: relative;
    display: grid;
    gap: 14px;
    padding: 18px 20px 24px;
    border-radius: 22px 0 22px 22px;
    background: var(--c-fior);
    color: var(--c-cacau);
    box-shadow:
      0 20px 40px -30px rgb(43 33 28 / 0.6),
      0 2px 0 rgb(43 33 28 / 0.08);
    transition:
      transform 0.5s var(--ease-creme),
      box-shadow 0.5s var(--ease-creme);
  }
  .ficha:hover {
    transform: translateY(-6px) rotate(-0.6deg);
    box-shadow:
      0 30px 50px -30px rgb(43 33 28 / 0.65),
      0 2px 0 rgb(43 33 28 / 0.08);
  }
  .ficha__canto {
    position: absolute;
    right: 0;
    top: 0;
    width: 44px;
    height: 44px;
    transform-origin: 100% 0;
    transition: transform 0.5s var(--ease-creme);
  }
  .ficha__dobra {
    fill: var(--c-pistache-creme);
  }
  .ficha:hover .ficha__canto {
    transform: scale(1.35);
  }
  .ficha__bola {
    width: 62%;
    margin: 0 auto;
    transition: transform 0.6s var(--ease-creme);
  }
  .ficha:hover .ficha__bola {
    transform: translateY(-6px) rotate(-3deg);
  }
  .ficha__textos {
    display: grid;
    gap: 8px;
  }
  .ficha__meta {
    font-size: 0.6rem;
    opacity: 0.62;
  }
  .ficha__nome {
    font-size: 1.15rem;
  }
  .ficha__desc {
    font-size: 0.95rem;
    line-height: 1.45;
  }
  .ficha__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 4px;
  }
  .ficha__tags .pilula {
    --pilula-bg: var(--c-pistache-creme);
    font-size: 0.56rem;
  }
  .ficha__tags .ficha__unidade {
    --pilula-bg: var(--c-ambar);
  }
</style>
