---
// O carrinho de gelato em traço (inspirado no carrinho redondo da loja, com roda de bicicleta).
// Rodas, guarda-sol e vitrine ficam em grupos separados para o GSAP animar.
interface Props {
  class?: string;
}
const { class: classe } = Astro.props;

const raio = (cx: number, cy: number, r: number, n: number) =>
  Array.from({ length: n }, (_, i) => {
    const a = (i / n) * Math.PI * 2;
    return `M${cx} ${cy}L${(cx + Math.cos(a) * r).toFixed(1)} ${(cy + Math.sin(a) * r).toFixed(1)}`;
  }).join('');
const regua = Array.from({ length: 19 }, (_, i) => `M${78 + i * 12} 184V${i % 2 ? 196 : 200}`).join('');
---

<svg class:list={['carrinho', classe]} viewBox="0 0 420 360" role="img" aria-label="Ilustração do carrinho de gelato da Crema Lab" focusable="false">
  <g class="carrinho__traco">
    <!-- chão -->
    <path class="carrinho__chao" d="M24 348C140 342 286 342 404 348" stroke-dasharray="2 9"></path>
  </g>

  <!-- tudo que balança na freada (o guarda-sol abre dentro dele, com origem própria) -->
  <g class="carrinho__balanco">
    <g class="carrinho__traco">
      <g class="carrinho__guarda-sol">
        <path d="M180 166V40"></path>
        <path d="M76 70C104 30 256 30 284 70"></path>
        <path d="M76 70C88 80 100 80 112 70C124 80 136 80 148 70C160 80 172 80 184 70C196 80 208 80 220 70C232 80 244 80 256 70C266 78 276 78 284 70"></path>
        <path d="M180 36L148 70M180 36L212 70M180 36L112 70M180 36L248 70"></path>
        <path d="M176 30C176 26 184 26 184 30"></path>
      </g>

      <!-- vitrine com as cubas -->
      <g class="carrinho__vitrine">
        <path d="M92 168L104 130H256L268 168"></path>
        <path d="M116 168C116 154 128 148 140 154C146 144 162 146 166 158"></path>
        <path d="M170 168C170 152 184 146 196 152C204 142 220 146 222 160"></path>
        <path d="M226 168C228 156 238 152 248 156"></path>
        <path d="M112 140L120 132" stroke-width="1.8"></path>
      </g>

      <!-- corpo cilíndrico -->
      <g class="carrinho__corpo">
        <path d="M46 168H314"></path>
        <path d="M70 176H290C300 176 306 184 306 194V284C306 294 300 302 290 302H70C60 302 54 294 54 284V194C54 184 60 176 70 176Z"></path>
        <path d={regua} stroke-width="1.8"></path>
        <path d="M66 264H294" stroke-width="1.6" stroke-dasharray="1 8"></path>
        <!-- alça e garfo -->
        <path d="M54 236C40 234 28 226 20 214"></path>
        <path d="M12 206L28 222"></path>
        <path d="M306 240L330 300"></path>
        <path d="M86 302L82 322"></path>
      </g>
    </g>
    <!-- logotipo no corpo -->
    <use class="carrinho__marca" href="#simbolo-wordmark" x="112" y="212" width="136" height="28" fill="currentColor"></use>
  </g>

  <!-- rodas -->
  <g class="carrinho__traco">
    <g class="carrinho__roda carrinho__roda--grande" data-centro="330 300">
      <circle cx="330" cy="300" r="44"></circle>
      <circle cx="330" cy="300" r="38" stroke-width="1.4"></circle>
      <path d={raio(330, 300, 38, 12)} stroke-width="1.2"></path>
      <circle cx="330" cy="300" r="5"></circle>
    </g>
    <g class="carrinho__roda carrinho__roda--pequena" data-centro="82 330">
      <circle cx="82" cy="330" r="16"></circle>
      <path d={raio(82, 330, 16, 6)} stroke-width="1.2"></path>
    </g>
  </g>
</svg>

<style>
  .carrinho {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .carrinho__traco {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
