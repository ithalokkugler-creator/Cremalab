---
// Selo Atemporal: texto em Blair girando em volta do monograma.
interface Props {
  id: string;
  class?: string;
  texto?: string;
}
const { id, class: classe, texto = 'Felicidade atemporal • Gelato + Café • ' } = Astro.props;
---

<div class:list={['selo', classe]} data-selo>
  <svg class="selo__anel" viewBox="0 0 200 200" aria-hidden="true" focusable="false">
    <defs>
      <path id={`${id}-circulo`} d="M100 100 m-74 0 a74 74 0 1 1 148 0 a74 74 0 1 1 -148 0"></path>
    </defs>
    <circle cx="100" cy="100" r="98" class="selo__fundo"></circle>
    <text class="selo__texto">
      <textPath href={`#${id}-circulo`} textLength="462" lengthAdjust="spacing">{texto.toUpperCase()}</textPath>
    </text>
  </svg>
  <svg class="selo__mono" viewBox="0 0 1359 2554" aria-hidden="true" focusable="false">
    <use href="#simbolo-monograma"></use>
  </svg>
  <span class="sr-only">Crema Lab — felicidade atemporal</span>
</div>

<style>
  .selo {
    position: relative;
    width: clamp(96px, 9vw, 132px);
    aspect-ratio: 1;
    color: var(--selo-tinta, var(--c-cacau));
  }
  .selo__anel {
    width: 100%;
    height: 100%;
  }
  .selo__fundo {
    fill: var(--selo-fundo, var(--c-fior));
  }
  .selo__texto {
    font-family: var(--f-display);
    font-size: 12.5px;
    letter-spacing: 0;
    fill: currentColor;
  }
  .selo__mono {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 22%;
    translate: -50% -50%;
    fill: currentColor;
  }
</style>
